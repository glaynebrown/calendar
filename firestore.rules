rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
//
// Two independent relationships:
// - `connections`: plain 1:1, visibility only. Never grants edit access.
// - `editIndex`: mutual edit-trust, granted only by sharing a household
//   (see store.js's addEditTrust/acceptInvite). Checked via editIndex/{uid}.ids
//   with a *direct* uid path segment -- Firestore rules can only reliably
//   get()/exists() a path built from a single direct value, not a
//   concatenated one or one passed through a wrapper function (confirmed the
//   hard way: both of those failed even though they're commonly-cited
//   patterns elsewhere), so every check below inlines the get() directly
//   rather than wrapping it in a helper.

function isSignedIn() {
  return request.auth != null;
}

function connectionId(a, b) {
  return a < b ? a + '_' + b : b + '_' + a;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can read any profile (names/colors need to be
    // visible to connections) -- only the owner can write their own.
    match /accounts/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Doc id is the deterministic connectionId(a, b) -- either side can
    // create or delete (matches addConnection/removeConnection being
    // unilateral in store.js), only if they're actually one of the two.
    // Visibility only -- see editIndex below for edit access.
    match /connections/{id} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      allow create: if isSignedIn()
        && (request.auth.uid == request.resource.data.a || request.auth.uid == request.resource.data.b)
        && id == connectionId(request.resource.data.a, request.resource.data.b);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
    }

    // Private per-person index of who has mutual edit-trust with them (see
    // store.js's addEditTrust/removeEditTrust), keyed directly by uid.
    // Only the owner can read their own (privacy). Only the owner can
    // freely rewrite it, but *anyone* can add or remove exactly their own
    // uid to/from someone else's list, since a mutual grant/revoke is
    // created by one side's action (joining/leaving a household) affecting
    // both people.
    match /editIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Two create paths: the normal fresh-signup init (ids == [], see
      // createAccountDoc), and self-healing an old account whose doc never
      // got created in the first place -- store.js's addEditTrust now uses
      // set(..., {merge:true}) instead of update() specifically so a
      // missing doc gets created here rather than permanently failing.
      // Owner can create their own doc with any content (they fully own
      // it either way); anyone else can only create a *missing* doc for
      // someone else with themselves as the sole initial entry, mirroring
      // the "append exactly myself" shape update already allows below.
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        request.resource.data.ids == [request.auth.uid]
      );
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (!(request.auth.uid in resource.data.ids) && request.auth.uid in request.resource.data.ids
          && request.resource.data.ids.size() == resource.data.ids.size() + 1) ||
        (request.auth.uid in resource.data.ids && !(request.auth.uid in request.resource.data.ids)
          && request.resource.data.ids.size() == resource.data.ids.size() - 1)
      );
    }

    // Readable by anyone signed in (an invite preview needs to show a
    // household's name before the reader is a member). Create: the founder
    // must be the sole initial member. Update, two shapes:
    // - "append exactly myself" (self-joining via an invite) -- deliberately
    //   does *not* require already being a member, since a brand-new joiner
    //   never is yet.
    // - "remove exactly one existing member" by any CURRENT member (any
    //   member can remove any member, including themselves) -- checked via
    //   size (shrinks by exactly one) plus hasAll (new list is a subset of
    //   the old one), so it can't be used to sneak in an unrelated change.
    match /households/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.memberIds == [request.auth.uid];
      allow update: if isSignedIn() && request.resource.data.name == resource.data.name && (
        request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]) ||
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds))
      );
    }

    // Readable by anyone signed in (resolving a code happens before the
    // reader has any other relationship to the invite). Writable by the
    // invite's owner, or by any current member for a household-owned invite.
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Read: gated by the denormalized `visibleTo` array (every uid allowed
    // to see the event -- computed client-side in store.js's
    // computeVisibleTo() from ownerId/visibility/customPeople whenever an
    // event is written). This is *not* just a modeling choice -- Firestore
    // can only validate a live collection query (as opposed to a single-doc
    // get) against a rule it can prove from the query itself, and the app's
    // calendar view is exactly that kind of live query
    // (.where('visibleTo', 'array-contains', uid)), so a compound rule
    // referencing visibility/customPeople directly would reject the query
    // outright rather than filtering it.
    // Write: the requester must be the event's owner, or have mutual
    // edit-trust with them (household co-membership -- matches the "author
    // an event as someone you know" feature, but only within a household
    // now, not for a plain connection) -- this part IS a single-doc check,
    // so it can use editIndex's richer get()-based logic without the
    // list-query restriction above applying.
    // Viewer grants: "viewerId can see ofUid's shared events." Readable by
    // every signed-in user (like households) because saving ANY event needs
    // the viewers of every participant. Only the viewer creates them, and
    // only for the people listed on a live 'viewer' invite they hold.
    // Removable by the viewer, the person viewed, whoever made the invite,
    // or anyone with edit rights on the viewed person's calendar.
    match /viewers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.viewerId
        && id == request.resource.data.viewerId + '_' + request.resource.data.ofUid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.type == 'viewer'
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.revoked == false
        && request.resource.data.ofUid in get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.viewOf
        && request.resource.data.createdBy == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.ownerId;
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.viewerId ||
        request.auth.uid == resource.data.ofUid ||
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in get(/databases/$(database)/documents/editIndex/$(resource.data.ofUid)).data.ids
      );
    }

    // Who may add events to someone's calendar and change only the ones
    // THEY added (connections -- see store.js's syncConnectIndex). Same
    // shape as editIndex: private to its owner, only the owner writes it,
    // except anyone may take exactly themselves off someone else's list.
    // legacyEditors = old one-way helpers whose events from before
    // connections were two-way (no createdBy) stay editable by them.
    match /connectIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (request.auth.uid in resource.data.ids && !(request.auth.uid in request.resource.data.ids)
          && request.resource.data.ids.size() == resource.data.ids.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ids']))
      );
    }

    // createdBy = whoever added the event. Rights:
    // - owner + household (editIndex): full control, EXCEPT an event one of
    //   the owner's connections added -- that one is the connection's alone.
    // - a connection (in the owner's connectIndex): can add events, and
    //   change/delete only the ones they added (or, for events from before
    //   createdBy existed, if they're one of the old legacyEditors).
    // - anyone who can see it: may change only their own reminder/day order
    //   or tap "Got it" on a repeat reminder (setMyReminder /
    //   setEventOrderForDate / ackReminder are targeted updates).
    // Nobody can rewrite createdBy, and a connection can't move an event
    // to someone else's calendar.
    match /events/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn()
        && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        && (
          request.auth.uid == request.resource.data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/editIndex/$(request.resource.data.ownerId)).data.ids ||
          (exists(/databases/$(database)/documents/connectIndex/$(request.resource.data.ownerId))
            && request.auth.uid in get(/databases/$(database)/documents/connectIndex/$(request.resource.data.ownerId)).data.ids)
        );
      allow update: if isSignedIn() && (
        (
          request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && (
            (
              (request.auth.uid == resource.data.ownerId ||
                request.auth.uid in get(/databases/$(database)/documents/editIndex/$(resource.data.ownerId)).data.ids)
              && !(resource.data.get('createdBy', request.auth.uid) != request.auth.uid
                && exists(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId))
                && resource.data.get('createdBy', '') in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.ids)
            ) ||
            (
              request.resource.data.ownerId == resource.data.ownerId
              && exists(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId))
              && request.auth.uid in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.ids
              && (resource.data.get('createdBy', '') == request.auth.uid
                || (!('createdBy' in resource.data)
                  && request.auth.uid in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.get('legacyEditors', [])))
            )
          )
        ) ||
        (request.auth.uid in resource.data.visibleTo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminders', 'hasReminders', 'orderByDate', 'ackReminders', 'reminderSnoozes']))
      );
      allow delete: if isSignedIn() && (
        (
          (request.auth.uid == resource.data.ownerId ||
            request.auth.uid in get(/databases/$(database)/documents/editIndex/$(resource.data.ownerId)).data.ids)
          && !(resource.data.get('createdBy', request.auth.uid) != request.auth.uid
            && exists(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId))
            && resource.data.get('createdBy', '') in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.ids)
        ) ||
        (
          exists(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId))
          && request.auth.uid in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.ids
          && (resource.data.get('createdBy', '') == request.auth.uid
            || (!('createdBy' in resource.data)
              && request.auth.uid in get(/databases/$(database)/documents/connectIndex/$(resource.data.ownerId)).data.get('legacyEditors', [])))
        )
      );
    }

    // The ORIGINAL flat, shared-by-everyone category list -- superseded by
    // categoryDefs below, but the rule stays exactly as simple and
    // permissive as it always was (never made visibleTo-aware) so
    // store.js's claimLegacyCategoriesIfNeeded can always read and delete
    // whatever's left of it with one plain unfiltered query, regardless of
    // how much of categoryDefs has already been populated. Mixing that
    // logic into one rules-aware collection would mean an unfiltered read
    // is no longer provable the moment even one doc anywhere has an owner
    // (Firestore rejects a query rules can't prove safe from its shape
    // alone) -- kept fully separate specifically to sidestep that.
    match /categories/{name} {
      allow read, write: if isSignedIn();
    }

    // Categories, replacing the flat list above: owned by whoever creates
    // them, visible only to the owner plus whoever they've explicitly
    // shared it with (see store.js's computeCategoryVisibleTo) -- not a
    // household-wide thing, since one household here spans several
    // genuinely separate people/couples who each want their own
    // categories private from each other by default.
    match /categoryDefs/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Private per-user saved view filters -- never read by anyone else.
    match /views/{uid}/customViews/{viewId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Private per-account APPEARANCE preferences (colors, category order,
    // theme, fonts, backgrounds -- see store.js's startSync `preferences`
    // listener and getTheme/getColorMap/etc). Same fully-private,
    // owner-only shape as views above -- this is what makes "my colors
    // look the same on every device I sign into" possible.
    match /preferences/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Each month's background lives in its own document, one per month
    // index, rather than a field on the shared preferences doc above --
    // see store.js's getMonthThemes for why (a single photo can otherwise
    // blow past Firestore's 1MiB-per-document cap and crowd out
    // everything else in that shared doc). Same fully-private, owner-only
    // shape either way.
    match /preferences/{uid}/monthThemes/{monthIndex} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /preferences/{uid}/plannerMonthThemes/{monthIndex} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // To-do lists / sticky notes. Read: same denormalized-visibleTo pattern
    // as events (see the comment there) -- visibleTo is just
    // [ownerId, ...sharedWith], computed client-side in store.js's
    // addNote/updateNote. Update is open to the owner AND anyone currently
    // in sharedWith (so a shared grocery list is actually collaborative --
    // checking off "milk" shouldn't require being the owner), but only the
    // owner can create or delete the note itself, so a shared viewer can't
    // unilaterally remove someone else's list or reassign who it belongs to.
    match /notes/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.sharedWith
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Date notes ("Mom flies home") -- short calendar labels that aren't
    // events. visibleTo is the explicit list of people it's shared with;
    // anyone on it can edit, re-share or delete it (agreed design, same as
    // events). The owner can't be swapped out, and whoever saves it must
    // stay on the list so a save can never orphan the note.
    // Your own look (colors/photo) for a shared list -- private to you.
    match /noteLooks/{id} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.noteId
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Standalone reminders (To-do tab). visibleTo = whoever made it plus
    // everyone it reminds. Editing follows events: the maker or their
    // household (editIndex); a connection's reminders are theirs alone.
    // Anyone it reminds may tap Got it or Later (only `state`/`snoozeAt`). The
    // reminders script (admin) also writes state/nextDueAt, and only sends
    // to people the maker could actually remind.
    match /reminders/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && request.resource.data.visibleTo.size() <= 30;
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.visibleTo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'snoozeAt'])) ||
        (request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.visibleTo is list
          && request.resource.data.visibleTo.size() <= 30
          && (request.auth.uid == resource.data.createdBy ||
            request.auth.uid in get(/databases/$(database)/documents/editIndex/$(resource.data.createdBy)).data.ids))
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in get(/databases/$(database)/documents/editIndex/$(resource.data.createdBy)).data.ids
      );
    }

    match /dateNotes/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && request.resource.data.visibleTo.size() <= 50;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.visibleTo
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && request.resource.data.visibleTo.size() <= 50;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
    }

    // Birthday records -- same denormalized-visibleTo pattern as events/notes
    // above (see store.js's computeBirthdayVisibleTo): unshared, visibleTo is
    // just the owner; shared, it's the owner plus every co-member across all
    // of their households at once. Only the owner can create/update/delete --
    // sharing a birthday makes it visible to others, never editable by them.
    match /birthdays/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Private gift-idea notes -- one per (birthday, author) pair, doc id is
    // "<birthdayId>_<authorUid>" (see store.js's setMyGiftIdeas). Only the
    // author can ever read or write their own note, regardless of who owns
    // the birthday it's about -- this is what keeps gift ideas private even
    // from the birthday's own owner, and independent between two different
    // people who both wrote notes about the same birthday.
    match /birthdayNotes/{id} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }
  }
}
